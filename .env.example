# Public base URL of the app, used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Notchs backend API.
NEXT_PUBLIC_API_URL=https://notchs-api.onrender.com

# Optional. "public" (the default on your machine) or "team" to try the team
# login locally. Netlify picks it by itself: public live, team on test links.
# SITE_ACCESS=team

# Team login for test links (team builds only). Server-side secrets: set them
# in Netlify for branch deploys and deploy previews, never in code.
# TEAM_USERNAME=
# TEAM_PASSWORD=
