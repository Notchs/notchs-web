# Public base URL of the app, used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Notchs backend API. The browser reaches it through the
# /api proxy in next.config.ts, so this is read at build time.
NEXT_PUBLIC_API_URL=https://notchs-api.onrender.com

# WhatsApp bot number, international format, digits only (e.g. 919876543210).
NEXT_PUBLIC_WHATSAPP_NUMBER=
