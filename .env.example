# Public base URL of the app, used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Notchs backend API. The browser reaches it through the
# /api proxy in next.config.ts, so this is read at build time.
NEXT_PUBLIC_API_URL=https://notchs-api.onrender.com

# WhatsApp bot number, international format, digits only (e.g. 919876543210).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional. "public" (the default on your machine) or "team" to try the team
# login locally. Netlify picks it by itself: public live, team on test links.
# SITE_ACCESS=team

# The same value as the API's PROXY_SECRET (a long random string). Server-side
# secret: set it in Netlify, never in code. With it, the API can tell visitors
# apart for its rate limits.
# API_PROXY_SECRET=

# Team login for test links (team builds only). Server-side secrets: set them
# in Netlify for branch deploys and deploy previews, never in code.
# TEAM_USERNAME=
# TEAM_PASSWORD=
