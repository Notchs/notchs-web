{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)"
    ],
    "ask": [
      "Edit(**/netlify.toml)",
      "Edit(**/next.config.ts)",
      "Edit(**/src/proxy.ts)",
      "Edit(**/src/shared/lib/team-access.ts)",
      "Edit(**/src/config/server-env.ts)",
      "Edit(**/src/app/robots.ts)",
      "Edit(**/src/app/sitemap.ts)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/.claude/**)",
      "Edit(**/.github/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
